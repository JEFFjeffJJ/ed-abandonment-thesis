# Track only the source files selected for this reference repository.
/*
!/.gitignore
!/README.md
!/run_pipeline.sh
!/src/
!/tests/
!/notebooks/
!/thesis/

/src/*
!/src/*.py
!/src/*.R
/tests/*
!/tests/*.py
/notebooks/*
!/notebooks/01_eda_dataset_overview.ipynb
/thesis/*
!/thesis/tum_thesis_v3/
/thesis/tum_thesis_v3/*
!/thesis/tum_thesis_v3/analysis/
/thesis/tum_thesis_v3/analysis/*
!/thesis/tum_thesis_v3/analysis/*.py

# Keep private data, model artifacts, environments, and caches local.
data/
outputs/
tmp/
.env
.env.*
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.csv
*.csv.gz
*.rds
